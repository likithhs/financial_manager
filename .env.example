# Flask Application Settings
SECRET_KEY=dev_academic_secret_key_financial_manager_2026
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
