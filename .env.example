# ====================================================================
# Finora - Personal Financial Manager & Investment Assistant
# Environment Configuration Template
# Copy this file to .env and fill in your keys
# ====================================================================

# --------------------------------------------------------------------
# 1. Flask Application Settings
# --------------------------------------------------------------------
# Generate a cryptographically secure 32-byte secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
# NOTE: Required in production; dev runtime will auto-generate an ephemeral key if empty.
SECRET_KEY=generate_with_python_secrets_token_hex_32

# Application Environment: 'development' or 'production'
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
PORT=5000

# --------------------------------------------------------------------
# 2. Rate Limiting Configuration (Flask-Limiter)
# --------------------------------------------------------------------
# Application-wide default limits (can be customized per your traffic requirements)
RATELIMIT_DEFAULT=200 per day; 60 per hour
# Storage URI: 'memory://' for local dev, or 'redis://localhost:6379' for production clustering
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_STRATEGY=fixed-window

# --------------------------------------------------------------------
# 3. Database Engine Selection
# --------------------------------------------------------------------
# Finora defaults to MySQL 8.0 ('mysql') as its primary relational engine.
# Set DB_ENGINE=sqlite to run in standalone zero-setup demo/offline mode.
# NOTE: Schemas and data differ; Finora does not automatically fallback between engines.
DB_ENGINE=mysql

# MySQL Database Configuration (used when DB_ENGINE=mysql)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=financial_manager
DB_PORT=3306

# SQLite Database Configuration (used when DB_ENGINE=sqlite)
# SQLITE_PATH=database/financial_manager.db

# --------------------------------------------------------------------
# 4. Administrator Provisioning
# --------------------------------------------------------------------
# To securely create an admin account, run:
#   flask init-admin
# Or pass CLI arguments:
#   flask init-admin --email admin@finora.local --password "SecurePass1234!" --name "Finora Admin"

# --------------------------------------------------------------------
# 5. AI Chatbot Multi-Provider Configuration
# --------------------------------------------------------------------
# Supported providers: 'gemini', 'openai', 'groq', or 'local'
AI_PROVIDER=gemini

# Primary API Key (Paste your Gemini, OpenAI, or Groq API key here)
AI_API_KEY=

# Specific provider keys (can also be used directly)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Recommended Models:
# Gemini: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
# OpenAI: gpt-4o-mini, gpt-4o
# Groq:   llama-3.3-70b-versatile, mixtral-8x7b-32768
AI_MODEL=gemini-2.5-flash

# --------------------------------------------------------------------
# 6. Stock Market Telemetry (AlphaVantage / Yahoo Finance)
# --------------------------------------------------------------------
STOCK_API_KEY=
STOCK_API_PROVIDER=demo
