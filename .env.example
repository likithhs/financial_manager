# ====================================================================
# Finora - Personal Financial Manager & Investment Assistant
# Environment Configuration Template
# Copy this file to .env and fill in your keys
# ====================================================================

# Flask Application Settings
# Generate a cryptographically secure 32-byte secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_generated_cryptographically_secure_32_byte_secret_key_here
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
PORT=5000

# Optional Initial Administrator Provisioning (or run 'flask init-admin')
# ADMIN_INITIAL_EMAIL=admin@yourdomain.com
# ADMIN_INITIAL_PASSWORD=YourStrongPasswordHere


# Database Engine Selection ('sqlite' for zero-setup local dev, 'mysql' for MySQL 8.0)
DB_ENGINE=sqlite

# MySQL Database Configuration (used when DB_ENGINE=mysql)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=financial_manager
DB_PORT=3306

# ====================================================================
# AI Chatbot Multi-Provider Configuration
# Supported providers: gemini, openai, groq, local
# ====================================================================
# Provider selection: 'gemini', 'openai', 'groq', or 'local'
AI_PROVIDER=gemini

# Primary API Key (Paste your Gemini, OpenAI, or Groq API key here)
AI_API_KEY=

# Optional: Specific provider keys (can be used interchangeably)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional model overrides:
# Gemini: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
# OpenAI: gpt-4o-mini, gpt-4o
# Groq:   llama-3.3-70b-versatile, mixtral-8x7b-32768
AI_MODEL=gemini-2.5-flash

# Stock Market Telemetry (AlphaVantage / Yahoo Finance)
STOCK_API_KEY=
STOCK_API_PROVIDER=demo
