# ====================================================================
# Finora - Personal Financial Manager & Investment Assistant
# Production & Development Environment Configuration Template
# Copy this file to .env and configure for your deployment
# ====================================================================

# --------------------------------------------------------------------
# 1. Flask Application Settings
# --------------------------------------------------------------------
# REQUIRED IN PRODUCTION: Generate a unique 32-byte secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
# On Render, 'generateValue: true' can generate this automatically.
SECRET_KEY=generate_with_python_secrets_token_hex_32

# Application Environment: 'development' or 'production'
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
PORT=5000

# Reverse Proxy Configuration (Werkzeug ProxyFix)
# Set to 1 when running behind Render, Heroku, Cloudflare, or Nginx
# Ensures client IP is accurately forwarded for security and rate limiting.
PROXY_FIX_NUM_PROXIES=1

# --------------------------------------------------------------------
# 2. Rate Limiting Configuration (Flask-Limiter)
# --------------------------------------------------------------------
# Application-wide default traffic limits
RATELIMIT_DEFAULT=200 per day; 60 per hour
# Dedicated rate limit per client IP for login attempts (brute-force defense)
RATELIMIT_LOGIN=10 per minute; 30 per hour
# Dedicated rate limit per client IP for account registrations
RATELIMIT_REGISTER=5 per minute; 15 per hour
# Storage URI: 'memory://' for local dev, or 'redis://localhost:6379' for production clusters
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_STRATEGY=fixed-window

# --------------------------------------------------------------------
# 3. Database Engine Selection ('sqlite' or 'mysql')
# --------------------------------------------------------------------
# Choose your active database engine:
# - 'sqlite': Zero-setup embedded database. On Render, requires a Persistent Disk
#             mounted at /var/data with SQLITE_PATH=/var/data/financial_manager.db
# - 'mysql':  Production relational database (AWS RDS, PlanetScale, Aiven, or local MySQL)
DB_ENGINE=mysql

# MySQL Database Configuration (used when DB_ENGINE=mysql)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=financial_manager
DB_PORT=3306

# SQLite Database Configuration (used when DB_ENGINE=sqlite)
# For local development:
SQLITE_PATH=database/financial_manager.db
# For Render Persistent Disk deployment (mountPath: /var/data):
# SQLITE_PATH=/var/data/financial_manager.db

# --------------------------------------------------------------------
# 4. Administrator Provisioning
# --------------------------------------------------------------------
# Email for the initial platform administrator account
DEFAULT_ADMIN_EMAIL=admin@finora.com

# REQUIRED IN PRODUCTION: Set a strong password (minimum 12 characters).
# If left blank in production, automatic creation is skipped for security.
# In local development, defaults to 'Admin@123456'.
DEFAULT_ADMIN_PASSWORD=

# You can also manually provision an administrator via CLI anytime:
#   python app.py init-admin --email admin@finora.com --password "SecurePass123!" --name "Finora Admin"

# --------------------------------------------------------------------
# 5. AI Chatbot Multi-Provider Configuration
# --------------------------------------------------------------------
# Supported providers: 'gemini', 'openai', 'groq', or 'local'
AI_PROVIDER=gemini

# Primary API Key (Paste your Gemini, OpenAI, or Groq API key here)
AI_API_KEY=

# Specific provider keys (can also be used directly)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Recommended Models:
# Gemini: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
# OpenAI: gpt-4o-mini, gpt-4o
# Groq:   llama-3.3-70b-versatile, mixtral-8x7b-32768
AI_MODEL=gemini-2.5-flash

# --------------------------------------------------------------------
# 6. Stock Market Telemetry (AlphaVantage / Yahoo Finance)
# --------------------------------------------------------------------
STOCK_API_KEY=
STOCK_API_PROVIDER=demo
